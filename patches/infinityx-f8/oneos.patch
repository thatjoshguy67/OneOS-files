@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Pixel's status bar in the guest (run 42, docs/pixel-guest.md): equal start and
+     end insets. Resources are mapped by name (SystemUIGoogle declares no
+     overlayable resources); scripts/make-overlays.sh builds it,
+     guest_prepare.sh puts it in the guest's /oem/overlay. -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="oneos.overlay.pixel.statusbar">
+    <application android:hasCode="false"/>
+    <overlay android:targetPackage="com.android.systemui"
+        android:isStatic="true"
+        android:priority="1"/>
+</manifest>
diff --git a/switcher/overlays/infinityx_fold8_statusbar/res/values/dimens.xml b/switcher/overlays/infinityx_fold8_statusbar/res/values/dimens.xml
new file mode 100644
index 0000000..0f6f641
--- /dev/null
+++ b/switcher/overlays/infinityx_fold8_statusbar/res/values/dimens.xml
@@ -0,0 +1,13 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SystemUIGoogle's StatusBarContentInsetsProvider: start inset = the corner
+     padding, end inset = max(dot padding, corner padding). In the guest the corner
+     padding is the framework's 0dp (Pixel's vendor overlay sets it; the guest runs
+     on Samsung's vendor) and the privacy dot padding 20dp, so the battery sat
+     47-60 px further from the right edge than the clock from the left. Both 8dp:
+     equal insets left to right, right to left, and after a locale change. -->
+<resources>
+    <dimen name="rounded_corner_content_padding">8dp</dimen>
+    <dimen name="ongoing_appops_dot_min_padding">8dp</dimen>
+    <dimen name="status_bar_padding_end">4dp</dimen>
+    <dimen name="status_bar_padding_top">0dp</dimen>
+</resources>
diff --git a/switcher/patches/fold8-infinityx/build-systemui.py b/switcher/patches/fold8-infinityx/build-systemui.py
