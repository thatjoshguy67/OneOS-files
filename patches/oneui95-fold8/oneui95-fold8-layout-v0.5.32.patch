 # equivalents over those host paths for the duration of the session, so those
 # daemons write into the guest's data. One UI is not running meanwhile and
 # return_to_oneui.sh removes the binds again.
+# One UI Home stores cover mirroring in its Preferences DataStore. Migrate that
+# one boolean from the stock launcher for this existing guest. The marker lets
+# Home settings take precedence after the first migration.
+f8_home_cover_sync() {
+    od -An -v -tu1 "$1" 2>/dev/null | awk '
+        function varint(    v,m,b) {
+            v=0; m=1
+            do {
+                if (p>n || m>268435456) exit 1
+                b=a[p++]; v+=b%128*m; m*=128
+            } while (b>=128)
+            return v
+        }
+        { for (i=1;i<=NF;i++) a[++n]=$i }
+        END {
+            if (n==0) exit 1
+            p=1
+            while (p<=n) {
+                if (a[p++]!=10) exit 1
+                len=varint(); end=p+len
+                if (end>n+1 || a[p++]!=10) exit 1
+                len=varint()
+                if (p+len>end) exit 1
+                key=""
+                for (i=0;i<len;i++) key=key sprintf("%c",a[p+i])
+                p+=len
+                if (key=="pref_cover_main_sync") {
+                    if (end-p!=4 || a[p]!=18 || a[p+1]!=2 || a[p+2]!=8 ||
+                        (a[p+3]!=0 && a[p+3]!=1)) exit 1
+                    print p+2, a[p+3]
+                    exit
+                }
+                p=end
+            }
+        }'
+}
+if [ "$ONEUI95_FOLD8" = 1 ] && [ ! -e "$STAGE/data/.oneui95-fold8-home-sync" ]; then
+    f8_home_path="com.sec.android.app.launcher/files/datastore/com.sec.android.app.launcher.common.prefs.preferences_pb"
+    f8_home_host="/proc/1/root/data/data/$f8_home_path"
+    f8_home_guest="$STAGE/data/user/0/$f8_home_path"
+    if [ -f "$f8_home_host" ] && [ -f "$f8_home_guest" ] &&
+       [ "$(readlink -f "$f8_home_guest")" = "$f8_home_guest" ]; then
+        f8_stock_sync=$(f8_home_cover_sync "$f8_home_host")
+        f8_guest_sync=$(f8_home_cover_sync "$f8_home_guest")
+        f8_sync_offset=${f8_guest_sync%% *}
+        case "$f8_stock_sync:$f8_guest_sync" in
+            *" 0":*" 1")
+                if printf '\000' | dd of="$f8_home_guest" bs=1 seek="$f8_sync_offset" conv=notrunc 2>/dev/null; then
+                    : > "$STAGE/data/.oneui95-fold8-home-sync"
+                    echo "One UI 9.5: kept the stock Fold8's independent cover Home layout"
+                fi ;;
+            *" 0":*" 0"|*" 1":*" 1")
+                : > "$STAGE/data/.oneui95-fold8-home-sync" ;;
+        esac
+    fi
+fi
